# Docker Compose public listener. Keep loopback unless a reverse proxy protects it.
TMAIL_HTTP_BIND=0.0.0.0
TMAIL_HTTP_PORT=8080

# Set to on when running behind a trusted HTTPS reverse proxy (e.g. host Nginx) that
# overwrites X-Forwarded-Proto and X-Forwarded-For so Secure admin cookies and canonical URLs work.
TMAIL_TRUST_FORWARD_HEADERS=off

[Unit]
Description=Tmail Policy Daemon
After=network.target

[Service]
User=tmail-policy
WorkingDirectory=/opt/tmail-policy
Environment=TMAIL_CONFIG=/var/lib/tmail-policy/config.json
ExecStart=/opt/tmail-policy/.venv/bin/python -m src.policy_daemon
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

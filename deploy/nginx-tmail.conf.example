# Nginx reverse proxy configuration for TMail origin server
# Deploy to: /etc/nginx/sites-available/tmail and symlink to /etc/nginx/sites-enabled/tmail
#
# Prerequisite:
#   1. Obtain SSL certificate (e.g. via certbot certonly --nginx -d yourdomain.com)
#   2. Run deploy/cloudflare-nginx-allowlist.sh to restrict traffic to Cloudflare IP ranges

server {
    listen 80;
    listen [::]:80;
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name tm-mails.com;

    # SSL certificates (Let's Encrypt or Cloudflare Origin CA)
    ssl_certificate /etc/letsencrypt/live/tm-mails.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tm-mails.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Cloudflare Origin Shield (managed by deploy/cloudflare-nginx-allowlist.sh)
    # Uncomment to restrict origin access strictly to Cloudflare edge IPs:
    # include /etc/nginx/snippets/cloudflare-allow.conf;

    # Server-Sent Events (SSE) realtime inbox stream — unbuffered proxying
    location = /messages/stream {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_buffering off;
        chunked_transfer_encoding on;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Public web app and API routing
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Stalwart Mail Server reverse proxy (JMAP HTTP, WebSockets, WebUI)
# Prerequisite: map $http_upgrade $connection_upgrade in /etc/nginx/conf.d/websocket.conf
server {
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name mail.tm-mails.com;

    ssl_certificate /etc/ssl/certs/mail.tm-mails.com.fullchain.pem;
    ssl_certificate_key /etc/ssl/private/mail.tm-mails.com.privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

